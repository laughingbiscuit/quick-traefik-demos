{
  "realm": "partners",
  "enabled": true,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false"},
      "protocolMappers": [
        {"name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper",
         "config": {"access.token.claim": "true", "introspection.token.claim": "true"}}
      ]
    },
    {
      "name": "all-services",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {"name": "audience orders-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
         "config": {"included.client.audience": "orders-api", "access.token.claim": "true", "id.token.claim": "false"}},
        {"name": "audience payments-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
         "config": {"included.client.audience": "payments-api", "access.token.claim": "true", "id.token.claim": "false"}}
      ]
    }
  ],
  "clients": [
    {"clientId": "partner-a", "secret": "Password123", "enabled": true, "publicClient": false, "standardFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true,
     "defaultClientScopes": ["basic", "all-services"], "optionalClientScopes": []},
    {"clientId": "partner-b", "secret": "Password123", "enabled": true, "publicClient": false, "standardFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true,
     "defaultClientScopes": ["basic", "all-services"], "optionalClientScopes": []},
    {"clientId": "internal", "secret": "Password123", "enabled": true, "publicClient": false, "standardFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true,
     "defaultClientScopes": ["basic", "all-services"], "optionalClientScopes": []},
    {"clientId": "partner-short-lived", "secret": "Password123", "enabled": true, "publicClient": false, "standardFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true,
     "attributes": {"access.token.lifespan": "2"},
     "defaultClientScopes": ["basic", "all-services"], "optionalClientScopes": []},
    {"clientId": "orders-api", "enabled": true, "bearerOnly": true},
    {"clientId": "payments-api", "enabled": true, "bearerOnly": true}
  ]
}
